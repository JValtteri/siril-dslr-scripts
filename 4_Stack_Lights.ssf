########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs a series of light images
#   process/
#     r_pp_light.ser
#
############################################

requires 1.2.6

cd process

# Stack calibrated lights to result.fit
stack r_pp_light rej 3 3 -norm=addscale -output_norm -out=../result

cd ..
close
