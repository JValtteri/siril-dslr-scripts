############################################
#
# Script for Siril 1.4.4
# September 2026
#
########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs 4 sets of RAW images in the working
# directory, within 4 directories:
#   biases/
#   flats/
#   darks/
#   lights/
#
# Outputs:
#   bias.ser
#   flat.ser
#   dark.ser
#   lights.ser
#   pp_light.ser
#   r_pp_light.ser
#   result.fit
#
############################################

requires 1.4.4

# 0

# Convert Bias Frames to .ser file
cd biases
convert bias -ser -out=../process
cd ..

# Convert Dark Frames to .ser files
cd darks
convert dark -ser -out=../process
cd ..

# Convert Flat Frames to .ser files
cd flats
convert flat -ser -out=../process
cd ..

# 1

cd process

# Stack Bias Frames to bias_stacked.fit
stack bias rej 3 3 -nonorm -out=../masters/bias_stacked

# Stack Dark Frames to dark_stacked.fit
stack dark rej 3 3 -nonorm -out=../masters/dark_stacked

# Pre-process Flat Frames
calibrate flat -bias=../masters/bias_stacked

# Stack Flat Frames to pp_flat_stacked.fit
stack pp_flat rej 3 3 -norm=mul -out=../masters/pp_flat_stacked

cd ..

# 2

# Convert Light Frames to .ser file
cd lights
convert light -ser -out=../process

cd ..

# 3

# Pre-process Light Frames
cd process
calibrate light -dark=../masters/dark_stacked -flat=../masters/pp_flat_stacked -cc=dark -cfa -equalize_cfa -debayer

# Align lights
register pp_light

cd ..
close
