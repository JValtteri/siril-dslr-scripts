############################################
#
# Script for Siril 1.4.4
# September 2025
#
########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs a set of RAW images
# in directory:
#   lights/
#
# Outputs:
#   lights.ser
#
############################################

requires 1.4.4

# Convert Light Frames to .ser file
cd lights
convert light -ser -out=../process

cd ..
close
