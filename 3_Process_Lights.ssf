############################################
#
# Script for Siril 1.4.4
# September 2025
#
########### PREPROCESSING SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs stacked calibration images
#   process/
#     darks_stacked.fit
#     pp_flat_stacked.fit
#
# Outputs:
#   pp_light.ser
#   r_pp_light.ser
#
############################################

requires 1.4.4

# Pre-process Light Frames
cd process
calibrate light -dark=../masters/dark_stacked -flat=../masters/pp_flat_stacked -cc=dark -cfa -equalize_cfa -debayer

# Align lights
register pp_light

cd ..
close
