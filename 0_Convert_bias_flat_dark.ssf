############################################
#
# Script for Siril 1.4.4
# September 2025
#
########### CONVERSION SCRIPT ###########
#
# Script for color camera preprocessing
#
# Needs 3 sets of RAW images
# in 3 directories:
#   biases/
#   flats/
#   darks/
#
# Outputs:
#   bias.ser
#   flat.ser
#   dark.ser
#
############################################

requires 1.4.4

# Convert Bias Frames to .ser files
cd biases
convert bias -ser -out=../process
cd ..

# Convert Dark Frames to .ser files
cd darks
convert dark -ser -out=../process
cd ..

# Convert Flat Frames to .ser files
cd flats
convert flat -ser -out=../process
cd ..

close
